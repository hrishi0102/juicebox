# Copy to cre/.env (git-ignored). Testnet keys only.
# Pays the Sepolia gas when you simulate with --broadcast (Sepolia ETH, for example from ethglobal.com/faucet).
CRE_ETH_PRIVATE_KEY=
# Free Arkiv access key (https://hub.arkiv.network/access-keys); Arkiv refuses anonymous queries.
ARKIV_ACCESS_KEY_ALL=
