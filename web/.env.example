# Copy to .env.local. Everything is optional. Use throwaway testnet keys only.

# GitHub (optional if `gh auth login` is done). Read access to your repos.
GITHUB_TOKEN=

# 0G Private Computer: the private judge. Key from https://pc.0g.ai (Dashboard, API Keys).
ZG_API_KEY=
# ZG_MODEL=0gm-1.0-35b-a3b        # the TEE-hosted chat model on the router
# ZG_TRUST_MODE=private           # private = only providers whose model runs in a TEE
# ZG_ROUTER_URL=https://router-api.0g.ai/v1
# ZG_SELF_VERIFY=1                # also check the TEE signature ourselves with the 0G SDK
# ZG_CHAIN_RPC=https://evmrpc.0g.ai

# Or use any OpenAI-compatible local model instead (for example Ollama):
# JUDGE_ENGINE=openai-compatible
# JUDGE_BASE_URL=http://localhost:11434/v1
# JUDGE_MODEL=llama3.1

# Arkiv (Rabdi testnet, chain 7794095): where shared receipts live.
# A throwaway key funded with tGLM from https://hub.arkiv.network/faucet
ARKIV_PRIVATE_KEY=
# Optional: https://hub.arkiv.network/access-keys (higher rate limits)
ARKIV_ACCESS_KEY=
# ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network

# Optional one-click signing without a browser wallet (throwaway key).
RECEIPTS_SIGNER_KEY=

# Team id used when sharing (or run: npm run receipts -- team <id> "Name")
# RECEIPTS_TEAM=my-team
# RECEIPTS_TEAM_NAME=My team

# Where local data lives (default ~/.receipts). On a hosted demo use a writable path like /tmp/receipts.
# RECEIPTS_DATA_DIR=
